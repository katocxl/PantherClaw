{
  "name": "PantherClaw",
  "image": "mcr.microsoft.com/devcontainers/go:2.3.1-1.27-bookworm@sha256:adc326255c019241228f9da4a1cb5d6a89abaaa0eb8d926a355b00af7daafd00",
  "containerEnv": {
    "GOFLAGS": "-mod=readonly",
    "GOTOOLCHAIN": "auto"
  },
  "postCreateCommand": "go tool -modfile=tools/pins/task/go.mod task setup",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "bufbuild.vscode-buf", "redhat.vscode-yaml", "editorconfig.editorconfig"]
    }
  },
  "remoteUser": "vscode"
}
