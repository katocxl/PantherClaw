{
  "realm": "pantherclaw",
  "displayName": "PantherClaw (development only)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "pantherclaw",
      "name": "PantherClaw server (development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "pantherclaw-dev-only-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://127.0.0.1:8080/oauth2/callback/keycloak", "http://localhost:8080/oauth2/callback/keycloak"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "-"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice-dev-only", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Viewer",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob-dev-only", "temporary": false }]
    }
  ]
}
