{
  "role": "all",
  "log": { "level": "info" },
  "http": { "addr": "127.0.0.1:8080" },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "name": "pantherclaw",
    "sslmode": "disable",
    "app_user": "pc_app",
    "app_password_file": "deploy/dev/secrets/pc_app.pw",
    "migrator_user": "pc_migrator",
    "migrator_password_file": "deploy/dev/secrets/pc_migrator.pw"
  },
  "kek_files": ["deploy/dev/secrets/kek"],
  "worker_concurrency": 4,
  "authority": {
    "grant_max_per_action": "100",
    "grant_currency": "USD",
    "budget_name": "dev-refunds",
    "permit_ttl": "5s",
    "stale_dispatch_after": "30s"
  },
  "dev_gateway": {
    "enabled": false,
    "gateway_id": "gw-dev-1",
    "org": "",
    "token_file": "deploy/dev/secrets/gateway.token"
  },
  "auth": {
    "public_url": "http://127.0.0.1:8080",
    "api_key_env": "dev",
    "oidc_providers": []
  }
}
