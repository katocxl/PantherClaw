# Copy to deploy/compose/.env (git-ignored) and set strong local-only values.
# Generate each one with: openssl rand -base64 32
PC_PG_PASSWORD=change-me-local-only
# Superuser password of the throwaway integration-test cluster (profile "test").
PC_PG_TEST_PASSWORD=change-me-local-only
# Keycloak admin console password (profile "identity"), local only.
KC_ADMIN_PASSWORD=change-me-local-only
